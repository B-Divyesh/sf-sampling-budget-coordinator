{
  "name": "sampling-budget-coordinator-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "npm run build:site",
    "build:site": "vite build --config site/vite.config.ts",
    "preview": "vite preview --config site/vite.config.ts",
    "test": "npm run test:cli && npm run test:site",
    "test:repeat": "npm test && npm test",
    "test:cli": "cargo fmt --check && cargo test",
    "test:site": "SBC_TESTING=1 npm run build:site && playwright test",
    "test:claim": "cargo build --locked && SBC_TESTING=1 npm run build:site && playwright test --grep",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "cargo fmt --check && cargo clippy --all-targets --all-features -- -D warnings"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
